rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos del chat: cada usuario sube a su carpeta; cualquier usuario
    // autenticado puede verlas. Solo imágenes y máximo 10 MB.
    match /chat_images/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Avatares de perfil: el archivo se llama "<uid>.jpg", así que cada usuario
    // solo puede escribir el suyo; cualquier autenticado puede verlos (ranking,
    // chat, perfil). Solo imágenes y máximo 5 MB.
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Todo lo demás denegado por defecto
  }
}
