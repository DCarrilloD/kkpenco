rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función de ayuda para verificar rol de admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Reglas para el documento de usuario
    match /users/{uid} {
      allow read: if request.auth != null;

      // Crear el propio documento al registrarse. El rol solo puede ser 'user':
      // el admin de un despliegue nuevo se eleva manualmente desde la consola.
      allow create: if request.auth != null && request.auth.uid == uid
                    && (!('role' in request.resource.data) || request.resource.data.role == 'user');

      // El dueño puede modificar su documento sin cambiar su rol.
      // Otros usuarios solo pueden tocar los campos de recompensas cruzadas
      // que escribe el cliente al finalizar duelos (duelsCompleted, achievements).
      allow update: if request.auth != null
                    && (
                      (request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['duelsCompleted', 'achievements'])
                      || isAdmin()
                    );

      allow delete: if request.auth != null && isAdmin();

      // Reglas para subcolecciones de usuarios como monthly_stats
      // (el admin también escribe al borrar eventos ajenos)
      match /monthly_stats/{statId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
      }
    }

    // Reglas para los eventos de caca
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.timestamp is timestamp
                    && request.resource.data.consistency is string
                    && request.resource.data.color is string
                    && request.resource.data.difficulty is number
                    && request.resource.data.difficulty >= 1
                    && request.resource.data.difficulty <= 5;
      allow update: if request.auth != null
                    && (resource.data.userId == request.auth.uid || isAdmin())
                    && (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId == resource.data.userId)
                    && (!request.resource.data.keys().hasAny(['difficulty']) || (request.resource.data.difficulty is number && request.resource.data.difficulty >= 1 && request.resource.data.difficulty <= 5));
      allow delete: if request.auth != null
                    && (isAdmin() || (resource.data.userId == request.auth.uid && (request.time - resource.data.timestamp) < duration.value(5, 'm')));
    }

    // Reglas para el chat
    match /chat/{messageId} {
      allow read: if request.auth != null;
      // Mensajes normales firmados con el uid del emisor; los mensajes de
      // sistema (logros, duelos, nudges) llevan userId 'system' y un campo
      // senderUid firmado con el uid real de quien los genera
      allow create: if request.auth != null
                    && request.resource.data.timestamp is timestamp
                    && request.resource.data.content is string
                    && (
                      request.resource.data.userId == request.auth.uid
                      || (request.resource.data.userId == 'system'
                          && request.resource.data.type == 'system'
                          && request.resource.data.senderUid == request.auth.uid)
                    );
      // Solo pueden modificarse reacciones y metadata (intentos de retos)
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'metadata']);
      // Borrar: el dueño del mensaje o un administrador
      allow delete: if request.auth != null
                    && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reglas para presencia/escritura en chat
    match /typing/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para duelos 1v1
    match /duels/{duelId} {
      // Solo los participantes ven el duelo (compatible con la query
      // arrayContains de getActiveDuels)
      allow read: if request.auth != null
                  && (request.auth.uid in resource.data.participants || isAdmin());
      // Crear: el retador debe ser quien firma, con exactamente 2 participantes
      allow create: if request.auth != null
                    && request.resource.data.challengerId == request.auth.uid
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.challengedId in request.resource.data.participants
                    && request.resource.data.status == 'pending';
      // Aceptar/puntuar/finalizar: solo participantes, sin cambiar quiénes son
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['participants', 'challengerId', 'challengedId']);
      allow delete: if request.auth != null
                    && (request.auth.uid in resource.data.participants || isAdmin());
    }

    // Lista blanca de correos: solo administradores.
    // (El chequeo en signUp está desactivado; si se reactiva en Fase 4 habrá
    // que repensar la lectura previa al registro.)
    match /authorized_emails/{email} {
      allow read, write: if request.auth != null && isAdmin();
    }
  }
}
