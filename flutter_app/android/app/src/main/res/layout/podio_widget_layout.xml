<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/podio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/poop_widget_background"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/podio_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/podio_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/podio_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/podio_me"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/widget_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        android:ellipsize="end"/>
</LinearLayout>
